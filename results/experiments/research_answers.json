  "Q2_qubo_validity": {
    "question": "Does the second-order QUBO reproduce the local ML mutation landscape sufficiently well?",
    "exact_regime": "0, 1 and 2 mutations: exact by construction",
    "K2_verdict": {
      "fidelity_within_fixed_mutation_count": "EXACT: the budget keeps every feasible selection inside the regime where the surrogate reproduces the ML score identically.",
